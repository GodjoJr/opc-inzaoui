{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h1>Invités</h1>
        <a href="{{ path('admin_guest_add') }}" class="btn btn-primary">Ajouter</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'info' ? 'warning' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Photos</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for guest in guests %}
                <tr>
                    <td>{{ guest.name }}</td>
                    <td>{{ guest.email }}</td>
                    <td>{{ guest.medias|length }}</td>
                    <td>
                        {% if guest.isActive %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-danger">Bloqué</span>
                        {% endif %}
                    </td>
                    <td>
                        <form method="post" action="{{ path('admin_guest_toggle_status', {id: guest.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('authenticate') }}">
                            {% if guest.isActive %}
                                <button type="submit" class="btn btn-warning">Bloquer</button>
                            {% else %}
                                <button type="submit" class="btn btn-success">Débloquer</button>
                            {% endif %}
                        </form>

                        <form method="post" action="{{ path('admin_guest_delete', {id: guest.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cet invité ainsi que toutes ses photos ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_guest_' ~ guest.id) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucun invité</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}